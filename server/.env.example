# MongoDB connection string
# Get one at https://cloud.mongodb.com or use local: mongodb://localhost:27017/collabx
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/collabx?retryWrites=true&w=majority

# OpenRouter API key for AI code review features
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Clerk publishable key (required for frontend — get from https://dashboard.clerk.com)
# Pass as build arg VITE_CLERK_PUBLISHABLE_KEY when building Docker image
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key (required for backend auth — get from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_...

# Optional: Override the Judge0 CE API URL (default: https://ce.judge0.com)
# JUDGE0_API_URL=https://ce.judge0.com

# Optional: Override the OpenRouter model (default: moonshotai/kimi-k2.7-code)
# OPENROUTER_MODEL=moonshotai/kimi-k2.7-code

# Server port (default: 3000)
# PORT=3000

# CORS allowed origins (comma-separated). Defaults to "*" if unset.
# Set to your frontend URL(s) in production, e.g. https://yourapp.com,http://localhost:5173
# CORS_ORIGIN=https://yourapp.com

# Your deployed app URL — used in OpenRouter HTTP-Referer header for analytics
# APP_URL=https://yourapp.com
